# Khmer AI Assistant — backend environment (placeholders only).
#
# NEVER commit a real key. Copy the needed lines into your secret manager
# (Cloudflare: `wrangler secret put <NAME>`; Supabase:
# `supabase secrets set --env-file backend/.env`) or export them for a local
# `deno run`. This file is intentionally ignored by git when named `.env`;
# `.env.example` is safe to commit because it holds no secrets.
#
# NOTE: the deployed Cloudflare Worker needs none of the *_API_KEY values. It
# calls Workers AI through the account's binding, so there is no provider key
# to set or leak. The HTTP variables below apply to the Supabase/Deno host.

# ---- Cloudflare Workers AI binding (primary host) --------------------------
# "true" routes calls through the Workers AI binding instead of HTTP.
AI_WORKERS_AI=false
# Workers AI model id used when AI_WORKERS_AI=true.
# AI_CHAT_MODEL=@cf/aisingapore/gemma-sea-lion-v4-27b-it

# ---- Chat / general model (HTTP hosts; required there) ---------------------
# Any OpenAI-compatible chat-completions endpoint. Examples:
#   SEA-LION API ....... https://api.sea-lion.ai/v1
#   Cloudflare REST .... https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
#   Self-hosted vLLM ... http://localhost:8000/v1
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
# e.g. aisingapore/Qwen-SEA-LION-v4.5-27B-IT  or  Qwen/Qwen3-8B
AI_CHAT_MODEL=

# ---- Translation model (optional) ------------------------------------------
# Set only when a dedicated translation model (e.g. GemmaX2 / MiLMMT) wins the
# Khmer evaluation. Falls back to the chat profile when unset.
AI_TRANSLATION_BASE_URL=
AI_TRANSLATION_API_KEY=
AI_TRANSLATION_MODEL=

# ---- Server-side limits (authoritative; the client caps are advisory) ------
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=45000

# ---- Access control --------------------------------------------------------
# Comma-separated allow-list for CORS. Empty means "*" (fine for local dev).
AI_ALLOWED_ORIGINS=
# Optional shared token the app must send as `Authorization: Bearer …`.
# Prefer real JWT verification per user in production.
AI_CLIENT_TOKEN=

# ---- JWT verification (optional) -------------------------------------------
# Any JWKS issuing asymmetric (RS256/ES256) tokens: Supabase, Cloudflare Access.
# Cloudflare Access example:
#   AUTH_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/certs
#   AUTH_ISSUER=https://<team>.cloudflareaccess.com
#   AUTH_AUDIENCE=<Access application AUD tag>
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Supabase shortcut: set only this and the JWKS URL + issuer are derived.
SUPABASE_URL=

